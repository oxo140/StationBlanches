[Unit]
Description=Monter en lecture seule le support USB %I
Requires=station-blanche-media.service
After=station-blanche-media.service dev-%i.device
BindsTo=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/station-blanche/mount-usb.sh %I
ExecStop=/bin/umount -- /srv/station-blanche/media/%I
TimeoutStartSec=30
TimeoutStopSec=15
