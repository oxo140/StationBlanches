{
    admin off
    default_sni {$STATION_IP}
    skip_install_trust
    auto_https disable_redirects
}
http://:8080 {
    reverse_proxy app:8080
}
https://{$STATION_IP} {
    tls internal
    import /etc/caddy/admin.caddy
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy app:8080
}
